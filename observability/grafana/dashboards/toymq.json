{
  "title": "ToyMQ",
  "uid": "toymq-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "tags": ["toymq"],
  "timezone": "browser",
  "panels": [
    {
      "type": "timeseries",
      "title": "Publish rate (msg/s)",
      "id": 1,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (topic) (rate(toymq_publish_total[1m]))",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "type": "timeseries",
      "title": "Publish bytes/s",
      "id": 2,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (topic) (rate(toymq_publish_bytes_total[1m]))",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" } }
    },
    {
      "type": "timeseries",
      "title": "Dedupe hit ratio (5m)",
      "id": 3,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(toymq_publish_dup_total[5m])) / clamp_min(sum(rate(toymq_publish_total[5m])), 1e-9)",
          "legendFormat": "dedupe hit ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } }
    },
    {
      "type": "timeseries",
      "title": "WAL append latency (s)",
      "id": 4,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, topic) (rate(toymq_wal_append_seconds_bucket[5m])))",
          "legendFormat": "p50 {{topic}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, topic) (rate(toymq_wal_append_seconds_bucket[5m])))",
          "legendFormat": "p95 {{topic}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, topic) (rate(toymq_wal_append_seconds_bucket[5m])))",
          "legendFormat": "p99 {{topic}}",
          "refId": "C"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "timeseries",
      "title": "Redelivery rate (msg/s)",
      "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (attempts_bucket) (rate(toymq_redelivery_total[5m]))",
          "legendFormat": "attempts {{attempts_bucket}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "Inflight messages",
      "id": 6,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "toymq_inflight_messages",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Active sessions",
      "id": 7,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "toymq_active_sessions", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Active subscriptions",
      "id": 8,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "toymq_active_subscriptions", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Topics",
      "id": 9,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "toymq_topic_count", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Goroutines",
      "id": 10,
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "go_goroutines", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Offsets flush rate (5m)",
      "id": 11,
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (topic, result) (rate(toymq_offsets_flush_total[5m]))",
          "legendFormat": "{{topic}} {{result}}",
          "refId": "A"
        }
      ]
    }
  ],
  "templating": { "list": [] },
  "annotations": { "list": [] }
}
