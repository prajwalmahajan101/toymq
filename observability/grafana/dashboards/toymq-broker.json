{
  "title": "ToyMQ \u2014 Broker internals",
  "uid": "toymq-broker",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "toymq"
  ],
  "timezone": "browser",
  "panels": [
    {
      "type": "timeseries",
      "title": "WAL append latency p99 (s) \u2014 click exemplars \u2192 trace",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, topic) (rate(toymq_wal_append_seconds_bucket[5m])))",
          "legendFormat": "p99 {{topic}}",
          "refId": "A",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 1
    },
    {
